name: proyecto_mlops_equipo_9

entry_points: 
  main:
    parameters:
      experimentname:
        type: string
        default: "mibici-entrenamiento"
      trackinguri:
        type: string
        default: "http://127.0.0.1:5000"
    command: >-
      python -m proyecto_mlops_equipo_9.modeling.train
      --experiment-name {experimentname}
      --tracking-uri {trackinguri}

  predict:
    parameters:
      trackinguri:
        type: string
        default: "http://127.0.0.1:5000"
    command: "python -m proyecto_mlops_equipo_9.modeling.predict --tracking-uri {trackinguri}"

  features:
    parameters:
      experimentname:
        type: string
        default: "mibici-feature-engineering"
      trackinguri:
        type: string
        default: "http://127.0.0.1:5000"
    command: >-
      python -m proyecto_mlops_equipo_9.features
      --experiment-name {experimentname}
      --tracking-uri {trackinguri}
